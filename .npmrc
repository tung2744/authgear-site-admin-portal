; Supply-chain hardening: refuse to resolve any dependency version
; published less than 7 days ago. Applies to `npm install`/`update`/
; `audit fix` (fresh version resolution) — NOT `npm ci`, which only
; ever installs exactly what package-lock.json already pins.
;
; Requires npm >= 11.10 (see engines in package.json) — older npm
; versions ignore this. Node >= 26.7.0 bundles a new-enough npm by
; default. npm currently warns "Unknown project config" here even
; though it works; that's an npm quirk, not a sign it's inactive
; (verified: a too-high threshold does reject resolution).
min-release-age=7

; Fail fast instead of silently skipping the check above on an npm
; version too old to support it.
engine-strict=true
